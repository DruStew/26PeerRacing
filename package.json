    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:list": "supabase migration list",
    "db:new": "supabase migration new",
    "setup:auth-email": "node --env-file=.env.local scripts/setup-resend-auth-email.mjs --push",
    "setup:stripe-membership": "node --env-file=.env.local scripts/setup-stripe-membership.mjs"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.2",
    "mapbox-gl": "^3.25.0",
    "next": "16.1.6",
    "opentype.js": "^2.0.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "supabase": "^2.98.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
