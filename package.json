{
  "name": "peer-racing-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "dev:firewall": "powershell -ExecutionPolicy Bypass -File scripts/allow-dev-lan-firewall.ps1",
    "dev:turbo": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import-fake-entries": "node scripts/import-fake-entries.mjs",
    "algo:parity": "node scripts/algorithm-parity/run-parity.mjs",
    "test-race:wipe": "node --use-system-ca --env-file=.env.local scripts/test-race/wipe-test-data.mjs",
    "test-race:seed": "node --use-system-ca --env-file=.env.local scripts/test-race/seed-runners.mjs",
    "test-race:checkin": "node --use-system-ca --env-file=.env.local scripts/test-race/check-in.mjs",
    "test-race:times": "node --use-system-ca --env-file=.env.local scripts/test-race/generate-times.mjs",
    "test-race:results": "node --use-system-ca --env-file=.env.local scripts/test-race/results-csv.mjs",
    "test-race:link": "node --use-system-ca --env-file=.env.local scripts/test-race/magic-link.mjs",
    "test-race:backfill-payouts": "node --use-system-ca --env-file=.env.local scripts/test-race/backfill-wallet-payouts.mjs",
    "test-race:backfill-promoter-finance": "node --use-system-ca --env-file=.env.local scripts/test-race/backfill-promoter-finance.mjs",
